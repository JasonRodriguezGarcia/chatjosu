# Runtime
NODE_ENV=development
PORT=5000
BACKEND_HOST=127.0.0.1

# HTTP / CORS
ALLOWED_ORIGINS=http://localhost:5173

# Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# PostgreSQL
SCHEMA_NAME=copilot_ong
DATABASE_PORT=5432
DATABASE_DETAILS={"DATABASE_USER":"copilot_ong","DATABASE_HOST":"127.0.0.1","DATABASE_DATABASE":"copilot_ong","DATABASE_PASSWORD":"replace_with_a_local_password","DATABASE_PORT":"5432"}

# HelpChat runtime hardening
HELPCHAT_JSON_LIMIT=16kb
HELPCHAT_AI_TIMEOUT_MS=12000
HELPCHAT_RATE_LIMIT_WINDOW_MS=60000
HELPCHAT_RATE_LIMIT_MAX=20
HELPCHAT_TRUST_CLOUDFLARE=false

# Privacy:
# false = do not persist literal user queries in tags_historico.
HELPCHAT_STORE_INPUT_MESSAGE=false
